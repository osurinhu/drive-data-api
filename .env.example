# Copie para .env e preencha. O .env NÃO é versionado.
#   cp .env.example .env
#
# Gere cada segredo com (não use menos de 32 bytes: o PyJWT avisa que chaves
# curtas são fracas demais para HMAC-SHA256):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# As senhas entram nas URLs de conexão que o compose monta: o token_urlsafe só usa
# letras, números, "-" e "_", que dispensam codificação.

# --- Banco (consumido pelo serviço `db` do docker-compose) -------------------
POSTGRES_USER=baseapi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=baseapi

# --- MongoDB e RabbitMQ (serviços `mongo` e `rabbitmq` do docker-compose) ------
# Valem só na primeira subida de cada volume: é nela que o usuário é criado.
# Trocar depois exige apagar o volume do serviço (base-api_mongo_data ou
# base-api_rabbitmq_data) com `docker volume rm`; `docker compose down -v` apagaria
# também o banco de desenvolvimento.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=troque-esta-senha-do-mongo
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=troque-esta-senha-do-rabbitmq

# --- Segredos da aplicação ----------------------------------------------------
SECRET_KEY=troque-por-um-token-aleatorio
JWT_SECRET_KEY=troque-por-outro-token-aleatorio

# --- Execução local fora do Docker -------------------------------------------
# O docker-compose monta estas URIs sozinho (apontando para os hosts `db`,
# `mongo` e `rabbitmq`). Descomente apenas se rodar `flask run` (ou
# `flask consumer run`) direto na máquina:
# FLASK_SQLALCHEMY_DATABASE_URI=postgresql+psycopg://baseapi:troque-esta-senha@localhost:5432/baseapi
# FLASK_MONGO_URI=mongodb://root:troque-esta-senha-do-mongo@localhost:27017/?authSource=admin
# FLASK_AMQP_URL=amqp://admin:troque-esta-senha-do-rabbitmq@localhost:5672/drive-data
# Só para o `flask rabbitmq setup` (no compose, só o job setup a recebe):
# FLASK_AMQP_MANAGEMENT_URL=http://admin:troque-esta-senha-do-rabbitmq@localhost:15672
# Perfil do processo (seção do settings.toml). Sem ele vale o [default], que
# carrega tudo; com FLASK_PROCESS=api, por exemplo, o Mongo nem é pedido.
# FLASK_PROCESS=api

# --- Testes -------------------------------------------------------------------
# Banco usado pela suíte pytest (criado automaticamente na primeira subida do
# compose). Suas tabelas são limpas a cada teste.
# Prefixo FLASK_ porque a suíte lê a configuração pelo mesmo caminho da
# aplicação (ext.config.build_config), em vez de interpretar o .env por conta.
FLASK_TEST_DATABASE_URI=postgresql+psycopg://baseapi:troque-esta-senha@localhost:5432/baseapi_test
# Mongo e RabbitMQ da suíte. O banco <MONGO_DATABASE>_test e o vhost
# drive-data-test isolam os testes dos dados de desenvolvimento; a suíte cria o
# vhost (e dá permissão a ele) pela API de gerenciamento.
FLASK_TEST_MONGO_URI=mongodb://root:troque-esta-senha-do-mongo@localhost:27017/?authSource=admin
FLASK_TEST_AMQP_URL=amqp://admin:troque-esta-senha-do-rabbitmq@localhost:5672/drive-data-test
FLASK_TEST_AMQP_MANAGEMENT_URL=http://admin:troque-esta-senha-do-rabbitmq@localhost:15672

# --- Execução -----------------------------------------------------------------
# Número de workers do gunicorn. Ao aumentar, refaça a conta do pool de
# conexões documentada no settings.toml.
# WEB_CONCURRENCY=2
